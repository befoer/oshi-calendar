{
  "name": "oshi-calendar",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "electron:dev": "npm run build && node scripts/bundle-electron.mjs && electron .",
    "electron:build": "npm run build && node scripts/bundle-electron.mjs && electron-builder --win"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.0.0",
    "ical.js": "^2.2.1",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "main": "electron-dist/main.mjs",
  "build": {
    "appId": "io.github.befoer.oshi-calendar",
    "productName": "推日",
    "copyright": "烧猫定食",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**",
      "electron/preload.cjs",
      "dist/**",
      "scripts/launcher.ico",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "scripts/launcher.ico"
    },
    "portable": {
      "artifactName": "oshi-calendar-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "oshi-calendar-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "befoer",
      "repo": "oshi-calendar",
      "releaseType": "release"
    },
    "afterPack": "scripts/audit-package.mjs",
    "afterAllArtifactBuild": "scripts/portable-release.mjs",
    "artifactName": "oshi-calendar-${version}-folder.${ext}"
  },
  "description": "推日 · 角色创作日历",
  "author": "烧猫定食",
  "repository": {
    "type": "git",
    "url": "https://github.com/befoer/oshi-calendar.git"
  }
}
